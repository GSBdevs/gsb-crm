# Copie para .env e ajuste. Sem .env, os defaults de dev funcionam (SQLite + workflows inline).

# --- Aplicação ---
APP_NAME="GrupoSB CRM"
ENV=dev
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Com ENV != dev a API se recusa a subir com chave de desenvolvimento.
SECRET_KEY=troque-esta-chave-em-producao

# --- Servidor (run.py) ---
# 0.0.0.0 expõe para a rede local (veja serve-lan.ps1 e o README)
API_HOST=127.0.0.1
API_PORT=8000
# Caminho do build do frontend (frontend/dist). Preenchido, a API serve a SPA
# na raiz — origem única, sem CORS. Vazio = dev com Vite (proxy).
FRONTEND_DIST=

# --- Rate-limit do login (falhas por IP antes do 429) ---
LOGIN_MAX_FAILURES=10
LOGIN_WINDOW_SECONDS=300

# --- Tokens JWT ---
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Banco de dados ---
# Dev sem Docker (default): SQLite local
# DATABASE_URL=sqlite+aiosqlite:///./crm_dev.db
# Com Docker/Postgres:
DATABASE_URL=postgresql+psycopg://crm:crm@localhost:5433/crm
# Criar tabelas automaticamente no startup (dev). Em produção use Alembic e deixe false.
AUTO_CREATE_TABLES=true

# --- Fila / Workers ---
REDIS_URL=redis://localhost:6379/0
# true = executa workflows no próprio processo da API (dev sem Redis/Celery)
WORKFLOWS_INLINE=false

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Email (ação send_email dos workflows; vazio = apenas loga) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=crm@gruposb.local
